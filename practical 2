# A* Search for 8 Puzzle
start = [1, 2, 3,
         4, 0, 6,
         7, 5, 8]

goal = [1, 2, 3,
        4, 5, 6,
        7, 8, 0]


# Heuristic function (Misplaced Tiles)
def heuristic(state):
    count = 0
    for i in range(9):
        if state[i] != 0 and state[i] != goal[i]:
            count += 1
    return count


# Generate neighboring states
def get_neighbors(state):
    neighbors = []
    pos = state.index(0)

    moves = {
        0: [1, 3],
        1: [0, 2, 4],
        2: [1, 5],
        3: [0, 4, 6],
        4: [1, 3, 5, 7],
        5: [2, 4, 8],
        6: [3, 7],
        7: [4, 6, 8],
        8: [5, 7]
    }

    for m in moves[pos]:
        new_state = state[:]
        new_state[pos], new_state[m] = new_state[m], new_state[pos]
        neighbors.append(new_state)

    return neighbors


# A* Search Algorithm
open_list = [(heuristic(start), 0, start)]
visited = set()
g_cost = {tuple(start): 0}

while open_list:

    open_list.sort()
    f, g, current = open_list.pop(0)

    if tuple(current) in visited:
        continue

    print(current)

    if current == goal:
        print("\nGoal Reached!")
        print("Total Cost:", g)
        break

    visited.add(tuple(current))

    for neighbor in get_neighbors(current):

        neighbor_tuple = tuple(neighbor)
        new_g = g + 1

        if neighbor_tuple not in visited:
            if neighbor_tuple not in g_cost or new_g < g_cost[neighbor_tuple]:

                g_cost[neighbor_tuple] = new_g
                h = heuristic(neighbor)
                f = new_g + h

                open_list.append((f, new_g, neighbor))

else:
    print("Goal not reachable")
