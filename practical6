# DFS for Water Jug Problem
 
visited = set()
 
def dfs(a, b):
    if (a, b) in visited:
        return
 
    visited.add((a, b))
    print((a, b))
 
    if a == 2 or b == 2:
        print("Goal Reached")
        return
 
    dfs(4, b)          # Fill Jug1
    dfs(a, 3)          # Fill Jug2
    dfs(0, b)          # Empty Jug1
    dfs(a, 0)          # Empty Jug2
 
    transfer = min(a, 3-b)
    dfs(a-transfer, b+transfer)
 
    transfer = min(b, 4-a)
    dfs(a+transfer, b-transfer)
 
dfs(0, 0)
